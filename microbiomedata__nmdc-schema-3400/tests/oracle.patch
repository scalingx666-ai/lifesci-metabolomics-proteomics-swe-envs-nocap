diff --git a/src/data/invalid/LabelingProcess-isotopolog-cid-zero.yaml b/src/data/invalid/LabelingProcess-isotopolog-cid-zero.yaml
new file mode 100644
index 0000000000..892b121f8f
--- /dev/null
+++ b/src/data/invalid/LabelingProcess-isotopolog-cid-zero.yaml
@@ -0,0 +1,19 @@
+# Invalid for one reason: isotopolog.term.id is the sentinel PUBCHEM.COMPOUND:0, which is
+# not a real compound identifier. PubChem's API returns HTTP 400 for CID 0.
+id: nmdc:labp-99-abcdef7
+name: labeling of my awesome biosample
+type: nmdc:LabelingProcess
+has_input:
+  - nmdc:bsm-99-123456
+has_output:
+  - nmdc:procsm-99-987654
+isotope:
+  - 13C
+isotopolog_label: isotopically labeled
+isotopolog_approach: single
+isotopolog:
+  - type: nmdc:ControlledTermValue
+    has_raw_value: an undefined mixture [PUBCHEM.COMPOUND:0]
+    term:
+      id: PUBCHEM.COMPOUND:0
+      type: nmdc:OntologyClass
