diff --git a/.github/workflows/codeql.yaml b/.github/workflows/codeql.yaml
index 0cffe23d21..2201302349 100644
--- a/.github/workflows/codeql.yaml
+++ b/.github/workflows/codeql.yaml
@@ -52,13 +52,13 @@ jobs:
           persist-credentials: false
 
