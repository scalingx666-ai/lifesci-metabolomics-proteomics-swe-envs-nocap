diff --git a/matchms/filtering/metadata_processing/require_correct_ms_level.py b/matchms/filtering/metadata_processing/require_correct_ms_level.py
new file mode 100644
index 000000000..c65b34143
--- /dev/null
+++ b/matchms/filtering/metadata_processing/require_correct_ms_level.py
@@ -0,0 +1,10 @@
+from typing import Optional
+from matchms.Spectrum import Spectrum
+
+
+def require_correct_ms_level(spectrum: Spectrum, required_ms_level: int = 2) -> Optional[Spectrum]:
+    if spectrum is None:
+        return None
+    if spectrum.get("ms_level") in (f"MS{required_ms_level}", str(required_ms_level)):
+        return spectrum
+    return None
diff --git a/tests/filtering/test_require_correct_ms_level.py b/tests/filtering/test_require_correct_ms_level.py
new file mode 100644
index 000000000..f51618ca7
--- /dev/null
+++ b/tests/filtering/test_require_correct_ms_level.py
@@ -0,0 +1,23 @@
+import pytest
+from matchms.filtering.metadata_processing.require_correct_ms_level import \
+    require_correct_ms_level
+from ..builder_Spectrum import SpectrumBuilder
+
+
+@pytest.mark.parametrize("metadata, ms_level_to_keep, spectrum_removed", [
+    ({"ms_level": "2"}, 2, False),
+    ({"ms_level": "MS2"}, 2, False),
+    ({}, 2, True),
+    ({"ms_level": "MS3"}, 2, True),
+    ({"ms_level": "MS2"}, 3, True),
+    ({"ms_type": "MS2"}, 2, False), # Check that key conversions are used
+])
+def test_require_correct_ms_level(metadata, ms_level_to_keep, spectrum_removed):
+    builder = SpectrumBuilder()
+    spectrum_in = builder.with_metadata(metadata).build()
+    spectrum = require_correct_ms_level(spectrum_in, ms_level_to_keep)
+
+    if spectrum_removed is True:
+        assert spectrum is None, "Expected spectrum to be filtered out since it does not have the correct ionmode"
+    else:
+        assert spectrum == spectrum_in
