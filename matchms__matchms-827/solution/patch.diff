+            assert float(M[i, j]) == pytest.approx(expected, abs=1e-6)
+
+
+def test_entropy_matrix_sparse_basic():
+    refs = [
+        build_spectrum([100, 200], [1.0, 0.5], precursor_mz=500.0),
+        build_spectrum([110, 300], [0.3, 1.0], precursor_mz=600.0),
