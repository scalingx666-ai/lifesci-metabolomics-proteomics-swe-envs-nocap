+  @Test
+  public void testContainsNaN() {
+    Assertions.assertFalse(new SimpleDoubleRange(1.0, 5.0).contains(Double.NaN));
+    Assertions.assertFalse(new SimpleFloatRange(1f, 5f).contains(Float.NaN));
+  }
