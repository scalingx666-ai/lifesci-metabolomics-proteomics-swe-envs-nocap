diff --git a/src/scripts/sync_module_settings.py b/src/scripts/sync_module_settings.py
new file mode 100644
index 0000000000..30f848956e
--- /dev/null
+++ b/src/scripts/sync_module_settings.py
@@ -0,0 +1,151 @@
+"""Copy the settings each schema module needs from src/schema/nmdc.yaml into that module.
+
+From linkml-runtime 1.12, a structured_pattern is interpolated only with the settings of the
+module that defines it (https://github.com/linkml/linkml/issues/4135). Settings declared in
+nmdc.yaml no longer reach patterns in the modules it imports, so those patterns keep literal
+placeholders such as {id_nmdc_prefix}. This script gives each module a settings block holding
+exactly the keys its interpolated patterns use, with values copied from nmdc.yaml, which stays
+the single place to edit a value.
+
+The block is written at the end of the module, after a marker comment, and is replaced on each
+run. Run it after changing a setting in nmdc.yaml or a pattern in a module:
+
+    poetry run python src/scripts/sync_module_settings.py src/schema/core.yaml ...
+
+With --check, nothing is written and the exit status is 1 if any module is out of date.
+See https://github.com/microbiomedata/nmdc-schema/issues/3523.
+"""
+
+import re
+import sys
+from pathlib import Path
+
+import click
+import yaml
+
+SCHEMA_DIR = Path(__file__).resolve().parents[2] / "src" / "schema"
+SOURCE_SCHEMA = SCHEMA_DIR / "nmdc.yaml"
+
+# A named {setting} placeholder. Regex repetition such as {2} or {0,6} is not one.
+PLACEHOLDER = re.compile(r"\{([A-Za-z_][A-Za-z0-9_]*)\}")
+
+MARKER = (
+    "# Settings below are copied from nmdc.yaml by src/scripts/sync_module_settings.py.\n"
+    "# Do not edit them here; edit nmdc.yaml and rerun the script.\n"
+    "# See https://github.com/microbiomedata/nmdc-schema/issues/3523\n"
+)
+
+
+def used_setting_keys(node: object) -> set[str]:
+    """Return the placeholder names used by interpolated structured_patterns anywhere in node.
+
+    >>> sorted(used_setting_keys({"s": {"structured_pattern": {"syntax": "^{a}:{b}[0-9]{2}$", "interpolated": True}}}))
+    ['a', 'b']
+    >>> used_setting_keys({"s": {"structured_pattern": {"syntax": "^{a}$"}}})
+    set()
+    """
+    keys: set[str] = set()
+    if isinstance(node, dict):
+        structured_pattern = node.get("structured_pattern")
+        if (
+            isinstance(structured_pattern, dict)
+            and structured_pattern.get("interpolated") is True
+        ):
+            keys.update(PLACEHOLDER.findall(str(structured_pattern.get("syntax", ""))))
+        for value in node.values():
+            keys.update(used_setting_keys(value))
+    elif isinstance(node, list):
+        for value in node:
+            keys.update(used_setting_keys(value))
+    return keys
+
+
+def source_settings(source_schema: Path = SOURCE_SCHEMA) -> dict[str, str]:
+    """Return the settings declared in the source schema as plain strings."""
+    with source_schema.open(encoding="utf-8") as f:
+        settings = yaml.safe_load(f).get("settings") or {}
+    return {key: str(value) for key, value in settings.items()}
+
+
+def strip_settings_block(text: str) -> str:
+    """Remove a block previously written by this script, if present.
+
+    >>> strip_settings_block("a: 1\\n\\n" + MARKER + "settings:\\n  x: 'y'\\n")
+    'a: 1\\n'
+    >>> strip_settings_block("a: 1\\n")
+    'a: 1\\n'
+    """
+    index = text.find(MARKER)
+    if index == -1:
+        return text
+    return text[:index].rstrip("\n") + "\n"
+
+
+def settings_block(keys: set[str], settings: dict[str, str]) -> str:
+    """Return the marker and a settings block for keys, quoted so YAML reads the values back unchanged."""
+    missing = sorted(keys - settings.keys())
+    if missing:
+        raise KeyError(
+            f"placeholders with no value in the source schema's settings: {', '.join(missing)}"
+        )
+    body = yaml.safe_dump(
+        {"settings": {key: settings[key] for key in sorted(keys)}},
+        default_style=None,
+        sort_keys=False,
+        allow_unicode=True,
+        width=float("inf"),
+    )
+    return MARKER + body
+
+
+def synced_text(module: Path, settings: dict[str, str]) -> str:
+    """Return the module's text with its settings block brought up to date."""
+    text = module.read_text(encoding="utf-8")
+    base = strip_settings_block(text)
+    parsed = yaml.safe_load(base)
+    if "settings" in parsed:
+        raise ValueError(
+            f"{module} declares its own settings outside the generated block"
+        )
+    keys = used_setting_keys(parsed)
+    if not keys:
+        return base
+    return base + "\n" + settings_block(keys, settings)
+
+
+@click.command()
+@click.argument(
+    "modules",
+    nargs=-1,
+    required=True,
+    type=click.Path(exists=True, dir_okay=False, path_type=Path),
+)
+@click.option(
+    "--check", is_flag=True, help="Write nothing; exit 1 if any module is out of date."
+)
+@click.option(
+    "--source",
+    default=SOURCE_SCHEMA,
+    show_default=True,
+    type=click.Path(exists=True, dir_okay=False, path_type=Path),
+    help="Schema whose settings are copied.",
+)
+def main(modules: tuple[Path, ...], check: bool, source: Path) -> None:
+    """Copy the settings each MODULE's interpolated structured_patterns use from the source schema."""
+    settings = source_settings(source)
+    stale = []
+    for module in modules:
+        new_text = synced_text(module, settings)
+        if new_text == module.read_text(encoding="utf-8"):
+            continue
+        stale.append(module)
+        if not check:
+            module.write_text(new_text, encoding="utf-8")
+            click.echo(f"updated {module}")
+    if check and stale:
+        click.echo("out of date: " + ", ".join(str(m) for m in stale), err=True)
+        sys.exit(1)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tests/test_module_settings.py b/tests/test_module_settings.py
new file mode 100644
index 0000000000..14a00f750a
--- /dev/null
+++ b/tests/test_module_settings.py
@@ -0,0 +1,289 @@
+"""Each schema module must carry the settings its interpolated structured_patterns use.
+
+linkml-runtime 1.12 interpolates a structured_pattern only with the settings of the module that
+defines it (https://github.com/linkml/linkml/issues/4135), so settings declared only in nmdc.yaml
+leave literal placeholders such as {id_nmdc_prefix} in every other module's patterns. The copies
+are written by src/scripts/sync_module_settings.py; nmdc.yaml stays the one place to edit a value.
+See https://github.com/microbiomedata/nmdc-schema/issues/3523.
+
+The checks resolve each module with PatternResolver on that module alone, which reads only the
+module's own settings on linkml-runtime 1.11 and 1.12 alike, so they fail on the old layout even
+though the locked runtime still merges settings across imports.
+"""
+
+from pathlib import Path
+
+import pytest
+import yaml
+from click.testing import CliRunner
+from linkml_runtime import SchemaView
+from linkml_runtime.utils.pattern import PatternResolver
+
+from src.scripts.sync_module_settings import (
+    MARKER,
+    PLACEHOLDER,
+    main,
+    settings_block,
+    source_settings,
+    strip_settings_block,
+    synced_text,
+    used_setting_keys,
+)
+
+SCHEMA_DIR = Path(__file__).resolve().parent.parent / "src" / "schema"
+SOURCE_SCHEMA = SCHEMA_DIR / "nmdc.yaml"
+
+
+def _load(path: Path) -> dict:
+    with path.open(encoding="utf-8") as f:
+        return yaml.safe_load(f)
+
+
+def _interpolated_syntaxes(node: object) -> list[str]:
+    found = []
+    if isinstance(node, dict):
+        structured_pattern = node.get("structured_pattern")
+        if (
+            isinstance(structured_pattern, dict)
+            and structured_pattern.get("interpolated") is True
+        ):
+            found.append(str(structured_pattern["syntax"]))
+        for value in node.values():
+            found.extend(_interpolated_syntaxes(value))
+    elif isinstance(node, list):
+        for value in node:
+            found.extend(_interpolated_syntaxes(value))
+    return found
+
+
+MODULES_WITH_PATTERNS = sorted(
+    path.name
+    for path in SCHEMA_DIR.glob("*.yaml")
+    if path.name != SOURCE_SCHEMA.name and used_setting_keys(_load(path))
+)
+
+# Every module but nmdc.yaml, so a block left behind after a module's last placeholder is
+# removed is still found as stale.
+ALL_MODULES = sorted(
+    path.name for path in SCHEMA_DIR.glob("*.yaml") if path.name != SOURCE_SCHEMA.name
+)
+
+
+def test_modules_with_interpolated_patterns_are_found() -> None:
+    """Guard against the parametrized tests below silently checking nothing."""
+    assert {
+        "core.yaml",
+        "basic_classes.yaml",
+        "mixs.yaml",
+        "workflow_execution_activity.yaml",
+    } <= set(MODULES_WITH_PATTERNS)
+
+
+@pytest.mark.parametrize("module_name", MODULES_WITH_PATTERNS)
+def test_module_declares_every_setting_its_patterns_use(module_name: str) -> None:
+    module = _load(SCHEMA_DIR / module_name)
+    declared = set((module.get("settings") or {}).keys())
+    missing = sorted(used_setting_keys(module) - declared)
+    assert not missing, f"{module_name} uses settings it does not declare: {missing}"
+
+
+@pytest.mark.parametrize("module_name", ALL_MODULES)
+def test_module_declares_no_unused_settings(module_name: str) -> None:
+    module = _load(SCHEMA_DIR / module_name)
+    declared = set((module.get("settings") or {}).keys())
+    extra = sorted(declared - used_setting_keys(module))
+    assert not extra, (
+        f"{module_name} declares settings none of its patterns use: {extra}"
+    )
+
+
+@pytest.mark.parametrize("module_name", MODULES_WITH_PATTERNS)
+def test_module_setting_values_match_nmdc_yaml(module_name: str) -> None:
+    source = source_settings(SOURCE_SCHEMA)
+    declared = _load(SCHEMA_DIR / module_name).get("settings") or {}
+    drifted = sorted(
+        key for key, value in declared.items() if str(value) != source.get(key)
+    )
+    assert not drifted, (
+        f"{module_name} settings differ from nmdc.yaml for {drifted}; rerun sync_module_settings.py"
+    )
+
+
+@pytest.mark.parametrize("module_name", MODULES_WITH_PATTERNS)
+def test_module_patterns_resolve_with_only_its_own_settings(module_name: str) -> None:
+    """The linkml 1.12 rule: a pattern sees only its own module's settings."""
+    resolver = PatternResolver(SchemaView(str(SCHEMA_DIR / module_name)))
+    unresolved = [
+        syntax
+        for syntax in _interpolated_syntaxes(_load(SCHEMA_DIR / module_name))
+        if PLACEHOLDER.search(resolver.resolve(syntax))
+    ]
+    assert not unresolved, (
+        f"{module_name}: {len(unresolved)} patterns keep placeholders, e.g. {unresolved[:3]}"
+    )
+
+
+def test_nmdc_yaml_patterns_resolve_with_its_own_settings() -> None:
+    resolver = PatternResolver(SchemaView(str(SOURCE_SCHEMA)))
+    unresolved = [
+        syntax
+        for syntax in _interpolated_syntaxes(_load(SOURCE_SCHEMA))
+        if PLACEHOLDER.search(resolver.resolve(syntax))
+    ]
+    assert not unresolved
+
+
+def test_settings_copies_are_up_to_date() -> None:
+    """The same check as `sync_module_settings.py --check` over every module."""
+    result = CliRunner().invoke(
+        main, ["--check", *(str(SCHEMA_DIR / name) for name in ALL_MODULES)]
+    )
+    assert result.exit_code == 0, result.output
+
+
+def test_settings_block_is_the_last_thing_in_each_module() -> None:
+    """The script replaces everything after the marker, so nothing hand-written may follow it."""
+    for module_name in MODULES_WITH_PATTERNS:
+        text = (SCHEMA_DIR / module_name).read_text(encoding="utf-8")
+        assert text.count(MARKER) == 1, module_name
+        tail = text[text.index(MARKER) + len(MARKER) :]
+        assert set(yaml.safe_load(tail).keys()) == {"settings"}, module_name
+
+
+# Unit tests for src/scripts/sync_module_settings.py
+
+
+@pytest.fixture
+def module_file(tmp_path: Path) -> Path:
+    path = tmp_path / "module.yaml"
+    path.write_text(
+        "id: https://example.org/module\n"
+        "name: module\n"
+        "slots:\n"
+        "  id:\n"
+        "    structured_pattern:\n"
+        "      syntax: '{id_nmdc_prefix}:x-{id_shoulder}-[0-9]{2}$'\n"
+        "      interpolated: true\n"
+        "  code:\n"
+        "    structured_pattern:\n"
+        "      syntax: '^{not_interpolated}$'\n",
+        encoding="utf-8",
+    )
+    return path
+
+
