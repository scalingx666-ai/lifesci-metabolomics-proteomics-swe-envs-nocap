+def _make_scorer(dtype=np.float32, *, index_step=0.01):
+    return EntropySearch(
+        tolerance=0.01,
+        max_tolerance=0.02,
+        peak_separation="raise",
+        noise_cutoff=0,
+        remove_precursor=False,
+        dtype=dtype,
+        index_step=index_step,
+    )
