+def _library_and_queries():
+    references = [
+        _peaks((100, 3), (150, 1)),
+        _peaks((100, 3), (150, 1)),  # exact tie: ID 0 precedes ID 1
+        _peaks((100, 1)),
+        _peaks((105, 1), (250, 2)),
+        _peaks((800, 2)),
+        _peaks(),
+        _peaks((101, 2), (200, 1)),
+    ]
+    queries = [
+        _peaks((100, 3), (150, 1)),
+        _peaks((105, 1), (250, 2)),
+        _peaks((999, 1)),
+        _peaks(),
+        _peaks((100, 5)),
+        _peaks((800, 1)),
+        _peaks((101, 3), (200, 2)),
+    ]
+    return references, queries
