+++ b/src/data/valid/Biosample-badges.yaml
@@ -0,0 +1,64 @@
+# A Biosample carrying one awarded metadata-quality badge.
+#
+# Badges are asserted by a downstream service, not by a submitter.
+#
+# This is a soil sample characterized chemically. It populates 6 of the 44 slots
+# in the biogeochemistry subset (ph, nitrate, ammonium, tot_org_carb,
+# tot_nitro_content, diss_org_carb), which clears that subset's
+# badge_minimum_slots of 2, so it is awarded the biogeochemistry badge.
+#
+# It populates no host_information slots and earns no host badge. That is the
+# normal case rather than an omission: environmental samples characterized by
+# their chemistry generally have no host organism, and host-associated samples
+# are generally not the ones carrying a full analyte panel. The two badges are
+# not expected to co-occur, and the portal shows only badges a sample earns.
+#
+# expert_curation cannot be illustrated by slot values at all. It is awarded
+# from ProvenanceMetadata.source_system_of_record, so no combination of
+# populated slots earns it.
+id: nmdc:bsm-99-badge01
+type: nmdc:Biosample
+name: soil_with_biogeochemistry_badge
+associated_studies:
+  - nmdc:sty-00-abc123
+env_broad_scale:
+  type: nmdc:ControlledIdentifiedTermValue
+  has_raw_value: ENVO:00002030
+  term:
+    type: nmdc:OntologyClass
+    id: ENVO:00002030
+env_local_scale:
+  type: nmdc:ControlledIdentifiedTermValue
+  has_raw_value: ENVO:00002169
+  term:
+    type: nmdc:OntologyClass
+    id: ENVO:00002169
+env_medium:
+  type: nmdc:ControlledIdentifiedTermValue
+  has_raw_value: ENVO:00005792
+  term:
+    type: nmdc:OntologyClass
+    id: ENVO:00005792
+ph: 6.8
+nitrate:
+  type: nmdc:QuantityValue
+  has_numeric_value: 12.4
+  has_unit: mg/L
+ammonium:
+  type: nmdc:QuantityValue
+  has_numeric_value: 3.1
+  has_unit: mg/L
+tot_org_carb:
+  type: nmdc:QuantityValue
+  has_numeric_value: 14.2
+  has_unit: mg/L
+tot_nitro_content:
+  type: nmdc:QuantityValue
+  has_numeric_value: 0.24
+  has_unit: "%"
+diss_org_carb:
+  type: nmdc:QuantityValue
+  has_numeric_value: 18.5
+  has_unit: mg/L
+badges:
+  - biogeochemistry
diff --git a/src/schema/basic_slots.yaml b/src/schema/basic_slots.yaml
index 18075277a5..2dfd7fde60 100644
--- a/src/schema/basic_slots.yaml
+++ b/src/schema/basic_slots.yaml
@@ -51,8 +51,65 @@ subsets:
         to the public JGI submission overview. To keep this subset exhaustive,
         add in_subset jgi_isolate wherever a JGI Isolate v19 structured_alias is
         added, at the same scope the alias lives (global slot or class slot_usage).
+  badge_topic:
+    description: >-
+      Group of subsets that each define a completeness-based metadata-quality
+      badge topic. A subset is a badge topic if its in_subset includes
+      badge_topic. Its members are the slots a record's completeness is measured
+      against when the badge for that topic is awarded, and its
+      badge_minimum_slots annotation is how many of them the record must
+      populate.
+    comments:
+      - Not every badge is completeness-based, so not every MetadataBadgeEnum
+        permissible value has a subset here. expert_curation is awarded from
+        ProvenanceMetadata.source_system_of_record rather than from slot
+        completeness, so it has no badge_topic subset.
+    see_also:
+      - https://github.com/microbiomedata/nmdc-schema/issues/3228
+  biogeochemistry:
+    description: >-
+      Biosample slots holding measured biogeochemical analytes: nitrogen,
+      phosphorus, carbon, sulfur, iron, core physicochemistry, and dissolved
+      gases. A Biosample populating at least badge_minimum_slots of these is
+      awarded the biogeochemistry badge.
+    annotations:
+      badge_minimum_slots: 2
+    see_also:
+      - https://github.com/microbiomedata/nmdc-schema/issues/3228
+      - https://github.com/microbiomedata/nmdc-schema/issues/3326
+    in_subset:
+      - badge_topic
+  host_information:
+    description: >-
+      Biosample slots describing the host organism a sample was taken from or
+      associated with: host taxonomy, anatomy, physiology, life stage, and
+      condition. A Biosample populating at least badge_minimum_slots of these is
+      awarded the host_information badge.
+    comments:
+      - Many NMDC biosamples have no host, so an absent host_information badge
+        means the slots are unpopulated, not that the sample is deficient. The
+        data portal shows only badges a sample has earned.
+    annotations:
+      badge_minimum_slots: 2
+    see_also:
+      - https://github.com/microbiomedata/nmdc-schema/issues/3228
+      - https://github.com/microbiomedata/nmdc-schema/issues/3326
+    in_subset:
+      - badge_topic
 
 slots:
+  badges:
+    description: >-
+      Metadata-quality badges awarded to this record. Each value names one
+      badge, which is present or absent; there are no levels or tiers. Most
+      badges name a completeness subset, but not all do: expert_curation is
+      awarded from provenance instead. Awarded by a downstream service, not
+      asserted by submitters, and recalculated whenever the record's
+      ProvenanceMetadata.mod_date changes.
+    range: MetadataBadgeEnum
+    multivalued: true
+    see_also:
+      - https://github.com/microbiomedata/nmdc-schema/issues/3227
