+@njit(cache=True, nogil=True)
+def _accumulate_losses(
+    query,
+    precursor_mz,
+    neutral_loss,
+    cursors,
+    hybrid_state,
+    n_library_peaks,
+    tolerance,
+    use_ppm,
+    hybrid,
+    epoch,
+):
