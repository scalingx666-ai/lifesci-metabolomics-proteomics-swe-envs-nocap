+          "IATNGPLKVGGSCVLSGHNLAKHCLHVVGPNVNKGEDIQLLKSAYENFNQHEVLLAPLLSAGIFGADP"
+          "IHSLRVCVDTVRTNVYLAVFDKNLYDKLVSSFL"),
+        identity_cutoff=0.99,
+        evalue_cutoff=1000
+      ),
