+            workspace.conflicts,
+            workspace.epochs,
+            workspace.last_query,
+            workspace.last_peak,
+            workspace.slots,
+            workspace.peak_word_epochs,
+            workspace.peak_word_bits,
+            workspace.conflict_slot,
+        )
