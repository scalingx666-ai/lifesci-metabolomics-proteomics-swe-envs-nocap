+    product_index = (library.peaks_mz, library.peaks_int, library.peaks_spec_idx)
+    loss_index = (library.nl_mz, library.nl_spec_idx, library.nl_product_idx)
+    library_info = (library.precursor_mz, library.spec_l2)
