+def _score_cosine_topk_block(
+    prepared: PreparedSpectra,
+    library: _CosineKernelData,
+    workspace: _CosineTopKWorkspace,
+    indices: np.ndarray,
+    scores: np.ndarray,
+    valid_counts: np.ndarray,
+    matches: np.ndarray | None,
+    first_row: int,
