+package io.github.mzmine.modules.visualization.dash_integration;
+
+import io.github.mzmine.modules.visualization.projectmetadata.table.columns.MetadataColumn;
+import org.jetbrains.annotations.NotNull;
+import org.jetbrains.annotations.Nullable;
+
+public record IntegrationDashboardSortOption(@Nullable MetadataColumn<?> metadataColumn,
+                                             @Nullable IntegrationDashboardAreaSortDirection areaSortDirection) {
+
+  public static IntegrationDashboardSortOption of(@NotNull MetadataColumn<?> column) {
+    return new IntegrationDashboardSortOption(column, null);
+  }
+
+  public static IntegrationDashboardSortOption of(@NotNull IntegrationDashboardAreaSortDirection direction) {
+    return new IntegrationDashboardSortOption(null, direction);
+  }
+
+  public boolean isMetadata() {
+    return metadataColumn != null;
+  }
+
+  public boolean isArea() {
+    return areaSortDirection != null && areaSortDirection != IntegrationDashboardAreaSortDirection.NONE;
+  }
+
+  @Override
+  public String toString() {
+    if (isMetadata()) {
+      return "Metadata: " + metadataColumn.getTitle();
+    }
+    if (areaSortDirection != null) {
+      return areaSortDirection.toString();
+    }
+    return "None";
+  }
+}
