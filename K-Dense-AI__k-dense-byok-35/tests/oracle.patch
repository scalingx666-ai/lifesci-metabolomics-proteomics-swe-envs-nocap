+ *  (B)", amd-smi says "gfx_activity" and "used_vram". */
+function amdGpuFields(entries: [string, unknown][]): GpuFields {
+  return {
+    utilizationPct:
+      metricNumber(pickEntry(entries, ["gpu", "use"], ["mem", "vram"])?.[1]) ??
+      metricNumber(pickEntry(entries, ["gfx", "activity"])?.[1]),
