+    memUsedBytes: Number.isFinite(Number(memUsed)) ? Number(memUsed) * 1024 * 1024 : null,
+    memTotalBytes: Number.isFinite(Number(memTotal)) ? Number(memTotal) * 1024 * 1024 : null,
+  };
