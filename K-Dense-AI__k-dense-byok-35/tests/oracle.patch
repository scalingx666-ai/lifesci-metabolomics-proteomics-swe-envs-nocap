+  "--showuse",
+  "--showmeminfo",
+  "vram",
+  "--showproductname",
+  "--json",
+];
+/** amd-smi is asked for whole groups instead of named fields: the field flags
+ *  have churned across releases where the JSON keys mostly haven't, and one
